{
    "name": "pushinbr/arcano",
    "description": "Arcano: a fast data mapper ORM for PHP and the PAM runtime, with attribute entities, schema builder and migrations. Derived from Cycle ORM.",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "doctrine/inflector": "^2.1",
        "doctrine/instantiator": "^1.3.1 || ^2.0",
        "psr/log": "1 - 3",
        "spiral/attributes": "^2.8 || ^3.1",
        "spiral/core": "^2.8 || ^3.0",
        "spiral/files": "^3.0",
        "spiral/pagination": "^2.8 || ^3.0",
        "spiral/reactor": "^3.0",
        "spiral/tokenizer": "^3.17",
        "symfony/polyfill-php83": "^1.28",
        "yiisoft/friendly-exception": "^1.1"
    },
    "require-dev": {
        "buggregator/trap": "^1.15",
        "doctrine/annotations": "^1.14 || ^2.0",
        "doctrine/collections": "^1.6 || ^2.0",
        "illuminate/collections": "9 - 12",
        "jetbrains/phpstorm-attributes": "^1.0",
        "loophp/collection": "^6.0 || ^7.0",
        "mockery/mockery": "^1.5",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.5",
        "ramsey/uuid": "^4.0",
        "roxblnfk/unpoly": "^1.8",
        "spiral/dumper": "^3.3",
        "symfony/console": "^6.0 || ^7.0",
        "vimeo/psalm": "^6"
    },
    "autoload": {
        "psr-4": {
            "Arcano\\ORM\\": "src/ORM/",
            "Arcano\\Database\\": "src/Database/",
            "Arcano\\Schema\\": "src/Schema/",
            "Arcano\\Annotated\\": "src/Annotated/",
            "Arcano\\Migrations\\": "src/Migrations/"
        },
        "files": [
            "src/Database/polyfill.php",
            "src/Database/functions_polyfill.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Arcano\\ORM\\Tests\\": "tests/ORM/",
            "Arcano\\Database\\Tests\\": "tests/Database/",
            "Arcano\\Schema\\Tests\\": "tests/Schema/",
            "Arcano\\Schema\\Generator\\Migrations\\Tests\\": "tests/SchemaMigrations/",
            "Arcano\\Annotated\\Tests\\": "tests/Annotated/",
            "Arcano\\Migrations\\Tests\\": "tests/Migrations/",
            "Arcano\\Migrations\\Fixtures\\": "tests/MigrationsFixtures/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
